      </geometry>
    </collision>
  </link>
  <joint name="arm_mount_bottom_joint" type="fixed">
    <origin xyz=" ${bus_frame_length/2+arm_mount_bias}
                  0.0
                  -${bus_frame_length/2-bus_frame_thickness/2}"
            rpy="${pi/2} 0.0 0.0"/>
    <parent link="bus_frame" />
