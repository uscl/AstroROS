    <origin xyz=" ${arm_link_1_length}
                  0.0
                  0.0"
            rpy="0.0 0.0 0.0"/>
    <parent link="arm_link_1_bottom" />
    <child link="arm_link_2_bottom"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
    <axis xyz="0.0 0.0 1.0"/>
  </joint>
  <link name="arm_link_3_bottom">
    <inertial>
