    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/arm_link_3.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="arm_link_3_right_joint" type="revolute">
    <origin xyz=" ${arm_link_2_length}
                  0.0
                  0.0"
            rpy="0.0 0.0 0.0"/>
    <parent link="arm_link_2_right" />
    <child link="arm_link_3_right"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
