  <joint name="arm_link_1_bottom_joint" type="revolute">
    <origin xyz=" ${arm_mount_bias}
                  0.0
                  0.0"
            rpy="0.0 0.0 0.0"/>
    <parent link="arm_mount_bottom" />
    <child link="arm_link_1_bottom"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
    <axis xyz="0.0 0.0 1.0"/>
