<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="satellite">

  <xacro:property name="bus_frame_mass"             value="400.0" />
  <xacro:property name="bus_frame_length"           value="3.0"   />
  <xacro:property name="bus_frame_thickness"        value="0.3" />

  <xacro:property name="rw_mount_mass"              value="4.0"   />
  <xacro:property name="rw_mount_width"             value="2.0"   />
  <xacro:property name="rw_mount_height"            value="1.0"   />

  <xacro:property name="rw_mass"                    value="1.0"   />
  <xacro:property name="rw_height"                  value="0.1" />
  <xacro:property name="rw_radius"                  value="0.25"/>

  <xacro:property name="dummy_mass"                 value="44.0"  />
  <xacro:property name="dummy_height"               value="0.3" />
  <xacro:property name="dummy_width"                value="2.0"   />

  <xacro:property name="thruster_mass"              value="1.0"   />
  <xacro:property name="thruster_height"            value="0.05"/>
  <xacro:property name="thruster_radius"            value="0.05"/>
  <xacro:property name="thruster_bias"              value="0.1" />

  <xacro:property name="window_mass"                value="1.0"   />
  <xacro:property name="window_length"              value="2.4" />
  <xacro:property name="window_thickness"           value="0.3" />

  <xacro:property name="bus_camera_mass"            value="1.0"   />
  <xacro:property name="bus_camera_height"          value="0.05"/>
  <xacro:property name="bus_camera_length"          value="0.5" />

  <xacro:property name="arm_mount_mass"             value="1.0"   />
  <xacro:property name="arm_mount_height"           value="0.4" />
  <xacro:property name="arm_mount_radius"           value="0.15"/>
  <xacro:property name="arm_mount_ixx"              value="0.35"/>
  <xacro:property name="arm_mount_iyy"              value="0.04"/>
  <xacro:property name="arm_mount_izz"              value="0.02"/>
  <xacro:property name="arm_mount_bias"             value="0.1" />

  <xacro:property name="arm_link_radius"            value="0.15"/>
  <xacro:property name="arm_link_height"            value="0.3" />
  <xacro:property name="arm_link_1_mass"            value="20.0"  />
  <xacro:property name="arm_link_2_mass"            value="15.0"  />
  <xacro:property name="arm_link_3_mass"            value="10.0"  />
  <xacro:property name="arm_link_1_length"          value="4.0"   />
  <xacro:property name="arm_link_2_length"          value="3.0"   />
  <xacro:property name="arm_link_3_length"          value="1.85"/>
  <xacro:property name="arm_link_1_ixx"             value="0.312"/>
  <xacro:property name="arm_link_2_ixx"             value="0.229"/>
  <xacro:property name="arm_link_3_ixx"             value="0.15"/>
  <xacro:property name="arm_link_1_iyy"             value="31.526"/>
  <xacro:property name="arm_link_2_iyy"             value="13.598"/>
  <xacro:property name="arm_link_3_iyy"             value="3.761"/>
  <xacro:property name="arm_link_1_izz"             value="31.524"/>
  <xacro:property name="arm_link_2_izz"             value="13.596"/>
  <xacro:property name="arm_link_3_izz"             value="3.759"/>

  <material name="white">
      <color rgba="1 1 1 0.8"/>
  </material>
  <material name="red">
      <color rgba="1 0 0 1"/>
  </material>
  <material name="orange">
      <color rgba="1 0.3 0.1 1"/>
  </material>
  <material name="blue">
      <color rgba="0.2 0.2 1 1"/>
  </material>
  <material name="green">
      <color rgba="0.0 1.0 0.0 1"/>
  </material>
  <material name="black">
      <color rgba="0 0 0 1"/>
  </material>
  <material name="grey">
      <color rgba="0.7 0.7 0.7 1"/>
  </material>
  <material name="pink">
      <color rgba="1 0.41 0.71 1"/>
  </material>
  <material name="cyan">
      <color rgba="0 1 1 1"/>
  </material>
  <material name="brown">
      <color rgba="0.35 0.22 0.15 1"/>
  </material>
  <material name="purple">
      <color rgba="0.5 0 0.5 1"/>
  </material>
  <material name="yellow">
      <color rgba="1 1 0 1"/>
  </material>
  <xacro:property name="PI"                         value="3.1415926535897931"/>

  <link name="bus_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${bus_frame_mass}"/>
      <inertia
              ixx="${(bus_frame_mass/6)*bus_frame_length*bus_frame_length}"
              iyy="${(bus_frame_mass/6)*bus_frame_length*bus_frame_length}"
              izz="${(bus_frame_mass/6)*bus_frame_length*bus_frame_length}"
              ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/bus_frame.stl" scale="1 1 1"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/bus_frame.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <link name="rw_mount">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${rw_mount_mass}"/>
      <inertia ixx="${(rw_mount_mass/20)*(4*rw_mount_height*rw_mount_height+rw_mount_width*rw_mount_width)}"
              iyy="${(rw_mount_mass/20)*(4*rw_mount_height*rw_mount_height+rw_mount_width*rw_mount_width)}"
              izz="${(rw_mount_mass/10)*(rw_mount_width*rw_mount_width)}"
              ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/reaction_wheel_mount.stl" scale="1 1 1"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/reaction_wheel_mount.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="rw_mount_joint" type="fixed">
    <origin xyz="0 0 -${rw_mount_height-bus_frame_thickness}" rpy="0.0 0.0 0.0"/>
    <parent link="bus_frame"/>
    <child link="rw_mount"/>
  </joint>
  <link name="rw_front">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${rw_mass}"/>
      <inertia ixx="${(rw_mass/12)*(3*rw_radius*rw_radius+rw_height*rw_height)}"
              iyy="${(rw_mass/12)*(3*rw_radius*rw_radius+rw_height*rw_height)}"
              izz="${(rw_mass/2)*rw_radius*rw_radius}"
              ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/reaction_wheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/reaction_wheel.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="rw_front_joint" type="continuous">
    <origin xyz="${rw_mount_width/4} 0 0" rpy="0.0 ${pi/4} 0.0"/>
    <parent link="rw_mount"/>
    <child link="rw_front"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rw_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${rw_mass}"/>
      <inertia ixx="${(rw_mass/12)*(3*rw_radius*rw_radius+rw_height*rw_height)}"
              iyy="${(rw_mass/12)*(3*rw_radius*rw_radius+rw_height*rw_height)}"
              izz="${(rw_mass/2)*rw_radius*rw_radius}"
              ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/reaction_wheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/reaction_wheel.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="rw_left_joint" type="continuous">
    <origin xyz="0 ${rw_mount_width/4} 0" rpy="-${pi/4} 0.0 0.0"/>
    <parent link="rw_mount"/>
    <child link="rw_left"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rw_back">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${rw_mass}"/>
      <inertia ixx="${(rw_mass/12)*(3*rw_radius*rw_radius+rw_height*rw_height)}"
              iyy="${(rw_mass/12)*(3*rw_radius*rw_radius+rw_height*rw_height)}"
              izz="${(rw_mass/2)*rw_radius*rw_radius}"
              ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/reaction_wheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/reaction_wheel.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="rw_back_joint" type="continuous">
    <origin xyz="-${rw_mount_width/4} 0 0" rpy="0.0 -${pi/4} 0.0"/>
    <parent link="rw_mount"/>
    <child link="rw_back"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rw_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${rw_mass}"/>
      <inertia ixx="${(rw_mass/12)*(3*rw_radius*rw_radius+rw_height*rw_height)}"
              iyy="${(rw_mass/12)*(3*rw_radius*rw_radius+rw_height*rw_height)}"
              izz="${(rw_mass/2)*rw_radius*rw_radius}"
              ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/reaction_wheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/reaction_wheel.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="rw_right_joint" type="continuous">
    <origin xyz="0 -${rw_mount_width/4} 0" rpy="${pi/4} 0.0 0.0"/>
    <parent link="rw_mount"/>
    <child link="rw_right"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="dummy">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${dummy_mass}"/>
      <inertia
              ixx="${(dummy_mass/12)*(dummy_width*dummy_width+dummy_height*dummy_height)}"
              iyy="${(dummy_mass/12)*(dummy_width*dummy_width+dummy_height*dummy_height)}"
              izz="${(dummy_mass/12)*(dummy_width*dummy_width+dummy_width*dummy_width)}"
              ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/dummy.stl" scale="1 1 1"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/dummy.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="dummy_joint" type="fixed">
    <origin xyz="0 0 ${bus_frame_length/2-bus_frame_thickness-dummy_height/2}" rpy="0 0.0 0.0"/>
    <parent link="bus_frame"/>
    <child link="dummy"/>
  </joint>
  <link name="thru_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${thruster_mass}"/>
      <inertia
        ixx="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        iyy="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        izz="${(thruster_mass/2)*thruster_radius*thruster_radius}"
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="thru_1_joint" type="revolute">
    <origin xyz=" ${bus_frame_length/2+thruster_height/2}
                  ${bus_frame_length/2-thruster_bias}
                  ${bus_frame_length/2-thruster_bias}"
            rpy="0.0 ${pi/2} 0.0"/>
    <parent link="bus_frame"/>
    <child link="thru_1"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
    <axis xyz="0.0 0.0 1.0"/>
  </joint>
  <link name="thru_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${thruster_mass}"/>
      <inertia
        ixx="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        iyy="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        izz="${(thruster_mass/2)*thruster_radius*thruster_radius}"
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="thru_2_joint" type="revolute">
    <origin xyz=" ${bus_frame_length/2-thruster_bias}
                  ${bus_frame_length/2+thruster_height/2}
                  ${bus_frame_length/2-thruster_bias}"
            rpy="0.0 ${pi/2} ${pi/2}"/>
    <parent link="bus_frame"/>
    <child link="thru_2"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
    <axis xyz="0.0 0.0 1.0"/>
  </joint>
  <link name="thru_3">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${thruster_mass}"/>
      <inertia
        ixx="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        iyy="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        izz="${(thruster_mass/2)*thruster_radius*thruster_radius}"
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="thru_3_joint" type="revolute">
    <origin xyz=" ${bus_frame_length/2-thruster_bias}
                  ${bus_frame_length/2-thruster_bias}
                  ${bus_frame_length/2+thruster_height/2}"
            rpy="0.0 0.0 0.0"/>
    <parent link="bus_frame"/>
    <child link="thru_3"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
    <axis xyz="0.0 0.0 1.0"/>
  </joint>
  <link name="thru_4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${thruster_mass}"/>
      <inertia
        ixx="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        iyy="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        izz="${(thruster_mass/2)*thruster_radius*thruster_radius}"
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="thru_4_joint" type="revolute">
    <origin xyz=" -${bus_frame_length/2+thruster_height/2}
                  ${bus_frame_length/2-thruster_bias}
                  -${bus_frame_length/2-thruster_bias}"
            rpy="0.0 -${pi/2} 0.0"/>
    <parent link="bus_frame"/>
    <child link="thru_4"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
    <axis xyz="0.0 0.0 1.0"/>
  </joint>
  <link name="thru_5">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${thruster_mass}"/>
      <inertia
        ixx="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        iyy="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        izz="${(thruster_mass/2)*thruster_radius*thruster_radius}"
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="thru_5_joint" type="revolute">
    <origin xyz=" -${bus_frame_length/2-thruster_bias}
                  ${bus_frame_length/2+thruster_height/2}
                  -${bus_frame_length/2-thruster_bias}"
            rpy="-${pi/2} 0.0 0.0"/>
    <parent link="bus_frame"/>
    <child link="thru_5"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
    <axis xyz="0.0 0.0 1.0"/>
  </joint>
  <link name="thru_6">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${thruster_mass}"/>
      <inertia
        ixx="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        iyy="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        izz="${(thruster_mass/2)*thruster_radius*thruster_radius}"
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find clear_space)/meshes/thruster.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="thru_6_joint" type="revolute">
    <origin xyz=" -${bus_frame_length/2-thruster_bias}
                  ${bus_frame_length/2-thruster_bias}
                  -${bus_frame_length/2+thruster_height/2}"
            rpy="0.0 -${pi} 0.0"/>
    <parent link="bus_frame"/>
    <child link="thru_6"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
    <axis xyz="0.0 0.0 1.0"/>
  </joint>
  <link name="thru_7">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${thruster_mass}"/>
      <inertia
        ixx="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        iyy="${(thruster_mass/12)*(3*thruster_radius*thruster_radius+thruster_height*thruster_height)}"
        izz="${(thruster_mass/2)*thruster_radius*thruster_radius}"
        ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
