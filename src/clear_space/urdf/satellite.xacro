      </geometry>
    </collision>
  </link>
  <joint name="arm_link_2_left_joint" type="revolute">
    <origin xyz=" ${arm_link_1_length}
                  0.0
                  0.0"
            rpy="0.0 0.0 0.0"/>
    <parent link="arm_link_1_left" />
    <child link="arm_link_2_left"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
    <axis xyz="0.0 0.0 -1.0"/>
