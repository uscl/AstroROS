    <origin xyz=" ${arm_link_2_length}
                  0.0
                  0.0"
            rpy="0.0 0.0 0.0"/>
    <parent link="arm_link_2_bottom" />
    <child link="arm_link_3_bottom"/>
    <limit effort="25" lower="-${pi/2}" upper="${pi/2}" velocity="1.5" />
    <axis xyz="0.0 0.0 1.0"/>
  </joint>

  <ros2_control name="arm_controller" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="arm_link_1_top_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.7853981633974483</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_link_2_top_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_link_3_top_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_link_1_bottom_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.7853981633974483</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_link_2_bottom_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_link_3_bottom_joint">
