<?xml version="1.0"?>
<!-- Macros that add Ignition Gazebo plugins for Franka Emika Panda -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="satellite">
<gazebo>
  <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
    <parameters>$(find satellite_description)/config/ros2_control.yaml</parameters>
  </plugin>
</gazebo>
