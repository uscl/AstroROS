<!-- check this works or not -->

<gazebo reference="dummy_bus_frame">
  <sensor name="satellite_imu_sensor" type="imu">
    <always_on>1</always_on>
    <update_rate>10.0</update_rate>
    <visualize>true</visualize>
    <topic>satellite_imu</topic>
    <imu>
      <topic>/imu/data</topic>
      <orientation>true</orientation>
      <angular_velocity>true</angular_velocity>
      <linear_acceleration>true</linear_acceleration>
    </imu>
  </sensor>
</gazebo>

<gazebo>
  <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu">
  </plugin>
</gazebo>
</robot>
